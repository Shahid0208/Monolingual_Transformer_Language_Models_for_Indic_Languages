{
  "batch_size": 32,
  "max_seq_len": 512,
  "max_steps": 10000,
  "learning_rate": 0.0005,
  "min_lr_ratio": 0.1,
  "weight_decay": 0.01,
  "warmup_steps": 500,
  "grad_clip": 1.0,
  "use_amp": true,
  "log_interval": 50,
  "eval_interval": 500,
  "eval_batches": 50,
  "save_interval": 2000,
  "optimizer": "AdamW",
  "betas": [0.9, 0.98],
  "eps": 1e-08,
  "scheduler": "cosine_with_warmup"
}
