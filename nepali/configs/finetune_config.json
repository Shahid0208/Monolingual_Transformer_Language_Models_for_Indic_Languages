{
  "batch_size": 32,
  "max_seq_len": 512,
  "num_epochs": 5,
  "learning_rate": 0.0002,
  "min_lr_ratio": 0.05,
  "weight_decay": 0.01,
  "warmup_steps": 50,
  "grad_clip": 1.0,
  "use_amp": true,
  "mask_prompt_loss": true,
  "log_interval": 25,
  "save_interval_epochs": 1,
  "optimizer": "AdamW",
  "betas": [0.9, 0.98],
  "eps": 1e-08,
  "scheduler": "cosine_with_warmup"
}
